#!/usr/bin/env python3
"""Stub `aws` for rds_compliance_report.sh tests. No network code; never talks to AWS.

One consistent fleet built from three sub-mocks (copies of the sibling repos' test mocks, plus the DocumentDB / Neptune mock):
  sub/patch_mock.py  (rds-patch-compliance)  instances, clusters, pending maintenance, engine versions, lifecycle, global clusters
  sub/backup_mock.py (rds-backup-compliance) instances, clusters, snapshots, AWS Backup vaults / recovery points, global clusters
  sub/docdb_mock.py  (this repo, v1.0)       DocumentDB / Neptune clusters, snapshots, recovery points
describe-db-clusters / -instances are the union (same identifier: fields merged, patch-mock fields win), so the sibling tools
and this script see the same data. The --query length(...) probe of rds-patch-compliance -A is answered here.
Profiles: prod -> 111111111111, nonprod -> 222222222222 (default: prod). Regions: us-east-1 us-west-2 ap-south-1 eu-west-1 ca-central-1.
MOCK_SCENARIO: fleet | empty | backupdeny | regionfail (us-west-2 describe-db-clusters AccessDenied) | any sub-mock scenario.
MOCK_NOW: fixed epoch.  MOCK_LOG: append argv as JSONL (one line per call to this mock).
"""
import json, os, subprocess, sys

HERE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "sub")
argv = sys.argv[1:]
if os.environ.get("MOCK_LOG"):
    with open(os.environ["MOCK_LOG"], "a") as fh:
        fh.write(json.dumps(argv) + "\n")
if argv[:1] == ["--version"]:
    print("aws-cli/2.38.6.mock Python/3 Linux"); sys.exit(0)
SCEN = os.environ.get("MOCK_SCENARIO", "fleet")


def opt(name, default=None):
    return argv[argv.index(name) + 1] if name in argv else default


def fail(code, op, msg):
    sys.stderr.write("\naws: [ERROR]: An error occurred (%s) when calling the %s operation: %s\n\n" % (code, op, msg)); sys.exit(254)


if argv[:3] == ["configure", "get", "region"]:
    r = os.environ.get("MOCK_DEFAULT_REGION", "")
    print(r) if r else None; sys.exit(0 if r else 1)
VAL = {"--output", "--profile", "--region", "--cli-connect-timeout", "--cli-read-timeout", "--filters", "--max-records", "--query",
       "--engine", "--engine-version", "--backup-vault-name", "--starting-token", "--page-size", "--max-items"}
pos, i = [], 0
while i < len(argv):
    if argv[i] in VAL: i += 2; continue
    if not argv[i].startswith("--"): pos.append(argv[i])
    i += 1
svc, op = (pos + ["", ""])[:2]
profile = opt("--profile", os.environ.get("AWS_PROFILE", "prod"))
region = opt("--region", os.environ.get("AWS_REGION", os.environ.get("AWS_DEFAULT_REGION", "us-east-1")))
ACCT = {"prod": "111111111111", "nonprod": "222222222222"}
if profile not in ACCT:
    fail("InvalidClientTokenId", "GetCallerIdentity", "The security token included in the request is invalid.")
acct = ACCT[profile]
if svc == "sts":
    print(json.dumps({"UserId": "AIDAMOCK", "Account": acct, "Arn": "arn:aws:iam::%s:user/dba" % acct})); sys.exit(0)
if svc == "ec2" and op == "describe-regions":
    print(json.dumps({"Regions": [{"RegionName": r, "Endpoint": "ec2.%s.amazonaws.com" % r, "OptInStatus": "opt-in-not-required"}
                                  for r in ["us-east-1", "us-west-2", "ap-south-1", "eu-west-1", "ca-central-1"]]})); sys.exit(0)
if SCEN == "regionfail" and region == "us-west-2" and op == "describe-db-clusters":
    fail("AccessDenied", "DescribeDBClusters", "User is not authorized to perform: rds:DescribeDBClusters")


def sub(name, args, prof=None):
    env = dict(os.environ); env.pop("MOCK_LOG", None)
    if name == "docdb_mock.py" and SCEN not in ("fleet", "empty", "backupdeny"): env["MOCK_SCENARIO"] = "fleet"
    if name == "patch_mock.py" and SCEN in ("backupdeny", "regionfail", "snapdeny", "globaldeny", "rpquirks"): env["MOCK_SCENARIO"] = "fleet"
    a = [svc, op] + args + ["--output", "json", "--region", region, "--profile", prof or profile]
    if name == "patch_mock.py": a.append("--no-cli-pager")
    p = subprocess.run([sys.executable, os.path.join(HERE, name)] + a, capture_output=True, text=True, env=env)
    if p.returncode:
        sys.stderr.write(p.stderr); sys.exit(p.returncode)
    return json.loads(p.stdout or "{}")


DOC_PROF = {"prod": "prod", "nonprod": "dev"}[profile]
if svc == "rds" and op in ("describe-db-clusters", "describe-db-instances"):
    key, idk = ("DBClusters", "DBClusterIdentifier") if op == "describe-db-clusters" else ("DBInstances", "DBInstanceIdentifier")
    parts = [sub("backup_mock.py", []).get(key, []), sub("patch_mock.py", []).get(key, [])]
    if key == "DBClusters": parts.insert(0, sub("docdb_mock.py", [], DOC_PROF).get(key, []))
    merged, order = {}, []
    for lst in parts:
        for x in lst:
            k = x.get(idk)
            if k not in merged: merged[k] = {}; order.append(k)
            merged[k].update(x)
    items = [merged[k] for k in order]
    if "--query" in argv:   # rds-patch-compliance -A probe: length(DBInstances) / length(DBClusters), first 20
        print(min(len(items), int(opt("--max-records", "100")))); sys.exit(0)
    print(json.dumps({key: items})); sys.exit(0)
if svc == "rds" and op == "describe-db-cluster-snapshots":
    a = sub("backup_mock.py", ["--include-shared"]).get("DBClusterSnapshots", [])
    print(json.dumps({"DBClusterSnapshots": a + sub("docdb_mock.py", [], DOC_PROF).get("DBClusterSnapshots", [])})); sys.exit(0)
if svc == "rds" and op == "describe-db-snapshots":
    print(json.dumps(sub("backup_mock.py", ["--include-shared"]))); sys.exit(0)
if svc == "backup" and op == "list-backup-vaults":
    v = sub("backup_mock.py", []).get("BackupVaultList", [])
    names = {x["BackupVaultName"] for x in v}
    v += [x for x in sub("docdb_mock.py", [], DOC_PROF).get("BackupVaultList", []) if x["BackupVaultName"] not in names]
    print(json.dumps({"BackupVaultList": v})); sys.exit(0)
if svc == "backup" and op == "list-recovery-points-by-backup-vault":
    n = opt("--backup-vault-name")
    rp = sub("backup_mock.py", ["--backup-vault-name", n]).get("RecoveryPoints", []) + sub("docdb_mock.py", ["--backup-vault-name", n], DOC_PROF).get("RecoveryPoints", [])
    seen, out = set(), []
    for x in rp:
        if x["RecoveryPointArn"] not in seen: seen.add(x["RecoveryPointArn"]); out.append(x)
    print(json.dumps({"RecoveryPoints": out})); sys.exit(0)
if svc == "rds" and op == "describe-global-clusters":
    g = {}
    for x in sub("backup_mock.py", []).get("GlobalClusters", []) + sub("patch_mock.py", []).get("GlobalClusters", []):
        g.setdefault(x["GlobalClusterIdentifier"], {}).update(x)
    print(json.dumps({"GlobalClusters": list(g.values())})); sys.exit(0)
if (svc, op) in (("rds", "describe-pending-maintenance-actions"), ("rds", "describe-db-major-engine-versions")) or op == "describe-db-engine-versions":
    extra = []
    for k in ("--engine", "--engine-version"):
        if k in argv: extra += [k, opt(k)]
    print(json.dumps(sub("patch_mock.py", extra))); sys.exit(0)
sys.stderr.write("\naws: [ERROR]: mock does not implement: %s %s\n" % (svc, op)); sys.exit(252)
